# ── Required secrets ─────────────────────────────────────────────────────────
# For local dev: fill in values below.
# For production (AWS): these are managed via Secrets Manager (see terraform/secrets.tf).
#   Do NOT commit real values. The ECS task definition injects them at runtime.

MONGO_PASSWORD=change_me_strong_password
API_KEY=change_me_random_32char_key

N8N_PASSWORD=change_me_n8n_password


MONGO_USER=autosec
MONGO_DB=autosecops

N8N_USER=admin
BACKEND_PORT=8000
N8N_PORT=5678

RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# Redis (Phase 3) — leave blank to use the in-memory fallback (single-process only)
REDIS_URL=redis://redis:6379/0

# CORS (Phase 3) — comma-separated allowed origins; defaults to * when blank (dev only)
CORS_ORIGINS=

SLACK_WEBHOOK_URL=
ALERT_EMAIL=
