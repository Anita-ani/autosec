{
  "name": "05 - Port Scan Detection",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "ingest-event",
        "responseMode": "lastNode",
        "options": {}
      },
      "id": "webhook-ingest-5",
      "name": "Webhook: Ingest Event",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [240, 300]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.event_type }}",
              "operation": "equal",
              "value2": "port_scan"
            }
          ]
        }
      },
      "id": "filter-port-scan",
      "name": "Filter: Port Scan Events Only",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [460, 300]
    },
    {
      "parameters": {
        "jsCode": "// Count port_scan events from this IP in the last 30 seconds\nconst ip = $input.first().json.source_ip;\nconst now = Date.now();\nconst windowMs = 30 * 1000;\nconst threshold = 20;\n\nconst staticData = $getWorkflowStaticData('global');\nif (!staticData.portScans) staticData.portScans = {};\n\nconst history = (staticData.portScans[ip] || []).filter(ts => now - ts < windowMs);\nhistory.push(now);\nstaticData.portScans[ip] = history;\n\nreturn [{\n  json: {\n    source_ip: ip,\n    scan_count: history.length,\n    suspicious: history.length >= threshold,\n    threshold,\n    window_seconds: 30\n  }\n}];"
      },
      "id": "count-port-scans",
      "name": "Code: Count Port Scans per IP",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [680, 240]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.suspicious }}",
              "value2": true
            }
          ]
        }
      },
      "id": "check-scan-threshold",
      "name": "Filter: Threshold Exceeded?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [900, 240]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.AUTOSEC_BACKEND_URL }}/alerts",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "X-API-Key", "value": "={{ $env.AUTOSEC_API_KEY }}" }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "alert_type", "value": "port_scan_detected" },
            { "name": "source_ip", "value": "={{ $json.source_ip }}" },
            { "name": "severity", "value": "high" },
            { "name": "message", "value": "={{ $json.scan_count }} port scan probes from {{ $json.source_ip }} in {{ $json.window_seconds }}s" },
            { "name": "triggered_by", "value": "n8n:port-scan-detection" }
          ]
        }
      },
      "id": "create-alert",
      "name": "HTTP: Create Alert",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [1120, 160]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.AUTOSEC_BACKEND_URL }}/block-ip",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "X-API-Key", "value": "={{ $env.AUTOSEC_API_KEY }}" }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "ip", "value": "={{ $json.source_ip }}" },
            { "name": "reason", "value": "Port scan: {{ $json.scan_count }} probes in {{ $json.window_seconds }}s" },
            { "name": "triggered_by", "value": "n8n:port-scan-detection" }
          ]
        }
      },
      "id": "block-ip-call",
      "name": "HTTP: Block IP",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [1340, 160]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SLACK_WEBHOOK_URL }}",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "text",
              "value": "=:warning: *AutoSecOps — Port Scan Detected*\nIP `{{ $json.source_ip }}` performed {{ $json.scan_count }} port scans in {{ $json.window_seconds }}s. IP has been blocked."
            }
          ]
        },
        "options": {}
      },
      "id": "slack-notify",
      "name": "Slack: Notify",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [1340, 320]
    }
  ],
  "connections": {
    "Webhook: Ingest Event": {
      "main": [[{ "node": "Filter: Port Scan Events Only", "type": "main", "index": 0 }]]
    },
    "Filter: Port Scan Events Only": {
      "main": [[{ "node": "Code: Count Port Scans per IP", "type": "main", "index": 0 }]]
    },
    "Code: Count Port Scans per IP": {
      "main": [[{ "node": "Filter: Threshold Exceeded?", "type": "main", "index": 0 }]]
    },
    "Filter: Threshold Exceeded?": {
      "main": [
        [{ "node": "HTTP: Create Alert", "type": "main", "index": 0 }],
        []
      ]
    },
    "HTTP: Create Alert": {
      "main": [[{ "node": "HTTP: Block IP", "type": "main", "index": 0 }]]
    },
    "HTTP: Block IP": {
      "main": [[{ "node": "Slack: Notify", "type": "main", "index": 0 }]]
    }
  },
  "active": true,
  "settings": { "errorWorkflow": "" },
  "tags": ["security", "phase-2"]
}
