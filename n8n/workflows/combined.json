ters": {"conditions": {"boolean": [{"value1": "={{ $json.suspicious }}", "value2": true}]}}, "id": "check-scan-threshold", "name": "Filter: Threshold Exceeded?", "type": "n8n-nodes-base.if", "typeVersion": 1, "position": [900, 240]}, {"parameters": {"method": "POST", "url": "={{ $env.AUTOSEC_BACKEND_URL }}/alerts", "authentication": "genericCredentialType", "genericAuthType": "httpHeaderAuth", "sendHeaders": true, "headerParameters": {"parameters": [{"name": "X-API-Key", "value": "={{ $env.AUTOSEC_API_KEY }}"}]}, "sendBody": true, "bodyParameters": {"parameters": [{"name": "alert_type", "value": "port_scan_detected"}, {"name": "source_ip", "value": "={{ $json.source_ip }}"}, {"name": "severity", "value": "high"}, {"name": "message", "value": "={{ $json.scan_count }} port scan probes from {{ $json.source_ip }} in {{ $json.window_seconds }}s"}, {"name": "triggered_by", "value": "n8n:port-scan-detection"}]}}, "id": "create-alert", "name": "HTTP: Create Alert", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [1120, 160]}, {"parameters": {"method": "POST", "url": "={{ $env.AUTOSEC_BACKEND_URL }}/block-ip", "authentication": "genericCredentialType", "genericAuthType": "httpHeaderAuth", "sendHeaders": true, "headerParameters": {"parameters": [{"name": "X-API-Key", "value": "={{ $env.AUTOSEC_API_KEY }}"}]}, "sendBody": true, "bodyParameters": {"parameters": [{"name": "ip", "value": "={{ $json.source_ip }}"}, {"name": "reason", "value": "Port scan: {{ $json.scan_count }} probes in {{ $json.window_seconds }}s"}, {"name": "triggered_by", "value": "n8n:port-scan-detection"}]}}, "id": "block-ip-call", "name": "HTTP: Block IP", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [1340, 160]}, {"parameters": {"method": "POST", "url": "={{ $env.SLACK_WEBHOOK_URL }}", "sendBody": true, "bodyParameters": {"parameters": [{"name": "text", "value": "=:warning: *AutoSecOps \u2014 Port Scan Detected*\nIP `{{ $json.source_ip }}` performed {{ $json.scan_count }} port scans in {{ $json.window_seconds }}s. IP has been blocked."}]}, "options": {}}, "id": "slack-notify", "name": "Slack: Notify", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [1340, 320]}], "connections": {"Webhook: Ingest Event": {"main": [[{"node": "Filter: Port Scan Events Only", "type": "main", "index": 0}]]}, "Filter: Port Scan Events Only": {"main": [[{"node": "Code: Count Port Scans per IP", "type": "main", "index": 0}]]}, "Code: Count Port Scans per IP": {"main": [[{"node": "Filter: Threshold Exceeded?", "type": "main", "index": 0}]]}, "Filter: Threshold Exceeded?": {"main": [[{"node": "HTTP: Create Alert", "type": "main", "index": 0}], []]}, "HTTP: Create Alert": {"main": [[{"node": "HTTP: Block IP", "type": "main", "index": 0}]]}, "HTTP: Block IP": {"main": [[{"node": "Slack: Notify", "type": "main", "index": 0}]]}}, "active": true, "settings": {"errorWorkflow": ""}}, {"name": "06 - Credential Stuffing Detection", "nodes": [{"parameters": {"httpMethod": "POST", "path": "ingest-event", "responseMode": "lastNode", "options": {}}, "id": "webhook-ingest-6", "name": "Webhook: Ingest Event", "type": "n8n-nodes-base.webhook", "typeVersion": 1, "position": [240, 300]}, {"parameters": {"conditions": {"string": [{"value1": "={{ $json.event_type }}", "operation": "equal", "value2": "login_attempt"}, {"value1": "={{ $json.status }}", "operation": "equal", "value2": "failed"}], "combineOperation": "all"}}, "id": "filter-failed-login", "name": "Filter: Failed Login Only", "type": "n8n-nodes-base.if", "typeVersion": 1, "position": [460, 300]}, {"parameters": {"jsCode": "// Detect credential stuffing: many failed logins from one IP targeting multiple accounts\n// Threshold: 10+ failures across 5+ distinct user_ids within 300 seconds\nconst ip = $input.first().json.source_ip;\nconst userId = $input.first().json.user_id || '__unknown__';\nconst now = Date.now();\nconst windowMs = 300 * 1000;\nconst failureThreshold = 10;\nconst distinctUserThreshold = 5;\n\nconst staticData = $getWorkflowStaticData('global');\nif (!staticData.credStuffing) staticData.credStuffing = {};\nif (!staticData.credStuffing[ip]) staticData.credStuffing[ip] = { events: [], users: {} };\n\nconst state = staticData.credStuffing[ip];\n\n// Prune old events\nstate.events = state.events.filter(e => now - e.ts < windowMs);\n\n// Prune old user entries\nfor (const uid of Object.keys(state.users)) {\n  state.users[uid] = state.users[uid].filter(ts => now - ts < windowMs);\n  if (state.users[uid].length === 0) delete state.users[uid];\n}\n\n// Record this event\nstate.events.push({ ts: now, userId });\nif (!state.users[userId]) state.users[userId] = [];\nstate.users[userId].push(now);\n\nconst failureCount = state.events.length;\nconst distinctUsers = Object.keys(state.users).length;\nconst suspicious = failureCount >= failureThreshold && distinctUsers >= distinctUserThreshold;\n\nreturn [{\n  json: {\n    source_ip: ip,\n    failure_count: failureCount,\n    distinct_users: distinctUsers,\n    suspicious,\n    failure_threshold: failureThreshold,\n    distinct_user_threshold: distinctUserThreshold,\n    window_seconds: 300\n  }\n}];"}, "id": "track-credential-stuffing", "name": "Code: Track Credential Stuffing", "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [680, 240]}, {"parameters": {"conditions": {"boolean": [{"value1": "={{ $json.suspicious }}", "value2": true}]}}, "id": "check-stuffing-threshold", "name": "Filter: Credential Stuffing?", "type": "n8n-nodes-base.if", "typeVersion": 1, "position": [900, 240]}, {"parameters": {"method": "POST", "url": "={{ $env.AUTOSEC_BACKEND_URL }}/alerts", "authentication": "genericCredentialType", "genericAuthType": "httpHeaderAuth", "sendHeaders": true, "headerParameters": {"parameters": [{"name": "X-API-Key", "value": "={{ $env.AUTOSEC_API_KEY }}"}]}, "sendBody": true, "bodyParameters": {"parameters": [{"name": "alert_type", "value": "credential_stuffing_detected"}, {"name": "source_ip", "value": "={{ $json.source_ip }}"}, {"name": "severity", "value": "critical"}, {"name": "message", "value": "={{ $json.failure_count }} failed logins across {{ $json.distinct_users }} accounts from {{ $json.source_ip }} in {{ $json.window_seconds }}s"}, {"name": "triggered_by", "value": "n8n:credential-stuffing-detection"}]}}, "id": "create-critical-alert", "name": "HTTP: Create Critical Alert", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [1120, 160]}, {"parameters": {"method": "POST", "url": "={{ $env.AUTOSEC_BACKEND_URL }}/block-ip", "authentication": "genericCredentialType", "genericAuthType": "httpHeaderAuth", "sendHeaders": true, "headerParameters": {"parameters": [{"name": "X-API-Key", "value": "={{ $env.AUTOSEC_API_KEY }}"}]}, "sendBody": true, "bodyParameters": {"parameters": [{"name": "ip", "value": "={{ $json.source_ip }}"}, {"name": "reason", "value": "Credential stuffing: {{ $json.failure_count }} failures across {{ $json.distinct_users }} accounts in {{ $json.window_seconds }}s"}, {"name": "triggered_by", "value": "n8n:credential-stuffing-detection"}]}}, "id": "block-stuffing-ip", "name": "HTTP: Block IP", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [1340, 160]}, {"parameters": {"method": "POST", "url": "={{ $env.SLACK_WEBHOOK_URL }}", "sendBody": true, "bodyParameters": {"parameters": [{"name": "text", "value": "=:rotating_light: *AutoSecOps \u2014 CRITICAL: Credential Stuffing Detected*\nIP `{{ $json.source_ip }}` made {{ $json.failure_count }} failed login attempts across *{{ $json.distinct_users }} accounts* in {{ $json.window_seconds }}s.\nIP has been blocked immediately."}]}, "options": {}}, "id": "slack-critical-notify", "name": "Slack: Critical Notify", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [1340, 320]}], "connections": {"Webhook: Ingest Event": {"main": [[{"node": "Filter: Failed Login Only", "type": "main", "index": 0}]]}, "Filter: Failed Login Only": {"main": [[{"node": "Code: Track Credential Stuffing", "type": "main", "index": 0}]]}, "Code: Track Credential Stuffing": {"main": [[{"node": "Filter: Credential Stuffing?", "type": "main", "index": 0}]]}, "Filter: Credential Stuffing?": {"main": [[{"node": "HTTP: Create Critical Alert", "type": "main", "index": 0}], []]}, "HTTP: Create Critical Alert": {"main": [[{"node": "HTTP: Block IP", "type": "main", "index": 0}]]}, "HTTP: Block IP": {"main": [[{"node": "Slack: Critical Notify", "type": "main", "index": 0}]]}}, "active": true, "settings": {"errorWorkflow": ""}}]